# Copy to .env.local for local development. Real values live in the client's
# Vercel and Supabase projects. Never commit real values.

# Supabase (client's project, Sydney region)
NEXT_PUBLIC_SUPABASE_URL=            # Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Public anon key (row-level security enforced)
SUPABASE_SERVICE_ROLE_KEY=           # Server only. Never expose to the browser.

# Active theme folder under themes/
NEXT_PUBLIC_THEME=foresite

# Alerts
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=          # Server only
TWILIO_ACCOUNT_SID=                  # Client's Twilio account
TWILIO_AUTH_TOKEN=                   # Server only
TWILIO_FROM_NUMBER=

# Device ingest (people counters etc.)
INGEST_SIGNING_SECRET=               # Per-environment; devices get their own per-device keys

# Connectors: one block per vendor, added by the add-connector skill
