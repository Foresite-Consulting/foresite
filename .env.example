# Copy to .env.local for local development. Real values live in the client's
# Vercel and Supabase projects. Never commit real values.

# Supabase (client's project, Sydney region)
NEXT_PUBLIC_SUPABASE_URL=            # Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # Public anon key (row-level security enforced)
SUPABASE_SERVICE_ROLE_KEY=           # Server only. Never expose to the browser.

# Active theme folder under themes/
NEXT_PUBLIC_THEME=foresite

# Alerts
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=          # Server only
TWILIO_ACCOUNT_SID=                  # Client's Twilio account
TWILIO_AUTH_TOKEN=                   # Server only
TWILIO_FROM_NUMBER=

# Database for server-side writes (device ingest). Server only. Supabase
# connection string for the transaction pooler, in the client's project.
# Production needs sslmode=verify-full, or DATABASE_CA_CERT below.
DATABASE_URL=
DATABASE_CA_CERT=                    # Optional PEM of the database's CA certificate (server only)

# Device ingest (people counters): POST /api/ingest/counters/<provider>.
# Each device has its own id and secret (npm run device:create -w apps/web);
# only scrypt hashes are stored, in the database. No shared ingest secret.
INGEST_STORAGE=postgres              # postgres (default) | memory (local runs and tests only; refused on Vercel production)
INGEST_MEMORY_DEVICES=               # memory storage only: JSON array from `device:create --memory-json` (hashes, never secrets)
INGEST_MAX_BODY_BYTES=65536          # Request body cap in bytes
INGEST_MAX_FUTURE_MINUTES=10         # Reject intervals ending further ahead than this (device clock wrong)
INGEST_MAX_AGE_DAYS=30               # Reject intervals that started longer ago than this
INGEST_LATE_AFTER_MINUTES=15         # Flag (but keep) intervals that ended longer ago than this
INGEST_RATE_LIMIT_CAPACITY=60        # Per-device burst (requests); per server instance until a shared store exists
INGEST_RATE_LIMIT_REFILL_PER_SECOND=1  # Per-device sustained rate
INGEST_AUTH_FAILURES_PER_MINUTE=10   # Failed logins allowed per client address and device id before 429
INGEST_AUTH_FAILURES_PER_ADDRESS_PER_MINUTE=100   # Backstop: failed logins per client address, any device id

# Connectors: one block per vendor, added by the add-connector skill
