{
  "$description": "Foresite base tokens, from Foresite Brand Guidelines v1.0 (PDF is master). Used for the design-system base layer and Foresite-branded demos. Client apps override colour, logo and name in themes/<client>/tokens.json.",
  "client": {
    "name": "Foresite",
    "appName": "Foresite",
    "appShortName": "Foresite",
    "logo": null,
    "logoOnDark": null,
    "icons": [
      { "src": "icon-192.png", "sizes": "192x192", "purpose": "any" },
      { "src": "icon-512.png", "sizes": "512x512", "purpose": "any" },
      { "src": "icon-maskable-512.png", "sizes": "512x512", "purpose": "maskable" }
    ],
    "favicon": null
  },
  "palette": {
    "jade": "#6DA097",
    "coral": "#FF6650",
    "ink": "#04282C",
    "mist": "#F4F7F6",
    "serpentine": "#06373C",
    "fog": "#C9DBD8",
    "moss": "#3E7268",
    "ember": "#C2412C",
    "white": "#FFFFFF",
    "borderDark": "#1D4A4F"
  },
  "semantic": {
    "light": {
      "bg": "mist",
      "surface": "white",
      "text-primary": "ink",
      "text-secondary": "moss",
      "brand": "jade",
      "action": "coral",
      "on-action": "ink",
      "link": "ember",
      "border": "fog",
      "positive": "moss",
      "negative": "ember",
      "forecast": "ember",
      "series": ["jade", "fog", "moss", "serpentine"]
    },
    "dark": {
      "bg": "ink",
      "surface": "serpentine",
      "text-primary": "mist",
      "text-secondary": "fog",
      "brand": "jade",
      "action": "coral",
      "on-action": "ink",
      "link": "mist",
      "border": "borderDark",
      "positive": "jade",
      "negative": "coral",
      "forecast": "coral",
      "series": ["jade", "fog", "moss", "mist"]
    }
  },
  "rules": [
    "Coral never touches Jade; separate with Ink.",
    "Ink text on Coral or Jade; never white on Coral.",
    "Never Coral or Jade text on Mist; use Ember or Moss.",
    "Actuals solid, comparisons Fog, forecasts dotted (Ember on light, Coral on dark).",
    "positive and negative colour the direction icon only; the words beside it use text colours.",
    "Links are always underlined. In dark mode the link colour is Mist: Coral on Serpentine measures 4.49:1, just under AA."
  ],
  "type": {
    "sans": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "scale": { "display": 72, "heading": 48, "subheading": 28, "body": 16, "label": 12 },
    "labelStyle": "Plex Mono, caps, +1px tracking"
  },
  "credit": "Built by Foresite"
}
